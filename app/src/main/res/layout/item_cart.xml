<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCartFlavor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMinus"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@color/light_bg"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="decrease" />

    <TextView
        android:id="@+id/tvCartQty"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="14sp"/>

    <ImageButton
        android:id="@+id/btnPlus"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@color/light_bg"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="increase" />

    <TextView
        android:id="@+id/tvCartLineTotal"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/cafe_red"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginStart="6dp"/>
</LinearLayout>
